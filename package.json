{
  "name": "markmind",
  "version": "2.1.0",
  "description": "Transform your chaotic bookmarks into organized bliss with AI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chromium && npm run build:firefox",
    "typecheck": "tsc --noEmit",
    "build:chromium": "tsc && vite build",
    "build:firefox": "tsc && vite build --config vite.firefox.config.ts",
    "lint:firefox": "node tools/lint-firefox.mjs",
    "test:firefox": "node tools/firefox-smoke.mjs",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir artifacts --filename markmind-firefox-{version}.zip --overwrite-dest",
    "lint": "eslint src/",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "bookmarks",
    "ai",
    "organization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.27",
    "@eslint/js": "^9.39.2",
    "@types/chrome": "^0.0.306",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.9",
    "web-ext": "^10.8.0"
  }
}
